# Copie para .env no ambiente local. Nunca use credenciais reais no Git.
AMBIENTE=desenvolvimento
NIVEL_LOG=INFO
NOME_APLICACAO=AgroConnect AI
# URL do PostgreSQL com usuário de banco estritamente read-only.
# Exemplo: postgresql+psycopg://usuario:senha@host:5432/banco
DATABASE_URL=

# Extensões futuras: manter segredos vazios neste arquivo de exemplo.
PROVEDOR_IA=
PROVEDOR_IA_MODELO=
PROVEDOR_IA_URL=
PROVEDOR_IA_API_KEY=

# Parâmetros técnicos do Isolation Forest; não são limites agronômicos.
ML_NUMERO_ESTIMADORES=200
ML_CONTAMINACAO=0.05
ML_SEMENTE_ALEATORIA=42
ML_MINIMO_OBSERVACOES=32
ML_CAMINHO_MODELO=modelos_treinados/isolation_forest.joblib
ML_VERSAO_MODELO=isolation-forest-v1
