# Copie para .env no ambiente local. Nunca use credenciais reais no Git.
AMBIENTE=desenvolvimento
NIVEL_LOG=INFO
NOME_APLICACAO=AgroConnect AI
# URL do PostgreSQL com usuário de banco estritamente read-only.
# Exemplo: postgresql+psycopg://usuario:senha@host:5432/banco
DATABASE_URL=

# Provedor compatível com Chat Completions. Deixe vazio para declarar indisponível.
PROVEDOR_IA=
PROVEDOR_IA_MODELO=
PROVEDOR_IA_URL=
PROVEDOR_IA_API_KEY=
PROVEDOR_IA_TIMEOUT_SEGUNDOS=30
# Limites de custo e transporte para Chat Completions.
PROVEDOR_IA_LIMITE_TOKENS_RESPOSTA=2048
# Use max_tokens apenas se o provedor compatível não aceitar max_completion_tokens.
PROVEDOR_IA_CAMPO_LIMITE_TOKENS=max_completion_tokens
PROVEDOR_IA_LIMITE_RESPOSTA_BYTES=1000000

# Parâmetros técnicos do Isolation Forest; não são limites agronômicos.
ML_NUMERO_ESTIMADORES=200
ML_CONTAMINACAO=0.05
ML_SEMENTE_ALEATORIA=42
ML_MINIMO_OBSERVACOES=32
ML_CAMINHO_MODELO=modelos_treinados/isolation_forest.joblib
ML_VERSAO_MODELO=isolation-forest-v1

# Fase 4 — caminhos locais; nenhum documento, índice ou modelo vem pré-instalado.
RAG_DIRETORIO_DOCUMENTOS=base_conhecimento/documentos
RAG_DIRETORIO_INDICE=base_conhecimento/indice
RAG_CAMINHO_EMBEDDINGS=modelos_embeddings/multilingual-e5-small
RAG_IDENTIFICADOR_MODELO_EMBEDDINGS=intfloat/multilingual-e5-small
RAG_REVISAO_EMBEDDINGS=fd1525a9fd15316a2d503bf26ab031a61d056e98
RAG_PREFIXO_CONSULTA_EMBEDDINGS="query: "
RAG_PREFIXO_DOCUMENTO_EMBEDDINGS="passage: "
RAG_TAMANHO_TRECHO=1200
RAG_SOBREPOSICAO_TRECHOS=160
RAG_LIMIAR_SIMILARIDADE=0.85
RAG_LIMITE_TRECHOS=5
RAG_ORCAMENTO_CONTEXTO_BYTES=100000
API_JSON_PROFUNDIDADE_MAXIMA=32
API_LIMITE_CORPO_HTTP_BYTES=65536
RAG_ANALISE_CHAVE_API=
# Somente para demonstração local. Mantenha false em qualquer ambiente exposto.
RAG_ANALISE_PERMITIR_SEM_CHAVE_LOCAL=false
RAG_ANALISE_RATE_LIMIT_REQUISICOES=30
RAG_ANALISE_RATE_LIMIT_JANELA_SEGUNDOS=60
RAG_INGESTAO_LIMITE_DOCUMENTO_BYTES=5000000
RAG_INGESTAO_LIMITE_DOCUMENTOS=100
RAG_INGESTAO_LIMITE_TOTAL_BYTES=50000000
RAG_INGESTAO_LIMITE_METADADOS_BYTES=65536
RAG_INGESTAO_LIMITE_TRECHOS=20000
