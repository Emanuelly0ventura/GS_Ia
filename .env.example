# Copie para .env no ambiente local. Nunca use credenciais reais no Git.
AMBIENTE=desenvolvimento
NIVEL_LOG=INFO
NOME_APLICACAO=AgroConnect AI
# PostgreSQL local exclusivo do módulo de IA (docker compose).
POSTGRES_DB=agroconnect_ai
POSTGRES_USER=agroconnect
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432
TELEMETRY_DATABASE_URL=postgresql+psycopg://agroconnect:change_me_local_only@localhost:5432/agroconnect_ai
TELEMETRY_DEVICE_TIMEOUT_SECONDS=60
TELEMETRY_SOIL_MOISTURE_TEMP_MIN_C=15
TELEMETRY_SOIL_MOISTURE_TEMP_MAX_C=35
# Vazio usa a mesma origem do FastAPI; quando definido, informe somente a origem HTTP(S).
DASHBOARD_API_BASE_URL=

# Configuração do Gemini para explicações generativas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SEGUNDOS=20


# Parâmetros técnicos do Isolation Forest; não são limites agronômicos.
ML_NUMERO_ESTIMADORES=200
ML_CONTAMINACAO=0.05
ML_SEMENTE_ALEATORIA=42
ML_MINIMO_OBSERVACOES=32
ML_CAMINHO_MODELO=modelos_treinados/isolation_forest.joblib
ML_VERSAO_MODELO=isolation-forest-v3
